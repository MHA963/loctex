{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "AOS Security Capability Broker Policy (SDK-Aligned 9-Tier Precedence)",
  "version": "2.0.0",
  "description": "Kernel-level security layer below agent execution implementing 9-tier declarative policy precedence, fail-closed argument checking, OS command sandboxing, and prompt-injection sanitization across all software toolchains.",
  "untrusted_input_sources": [
    "repository_files",
    "git_commit_messages",
    "github_issues_and_pr_comments",
    "fetched_web_pages",
    "external_api_responses",
    "tool_command_outputs"
  ],
  "sandbox_config": {
    "enable_sandbox": true,
    "workspace_only": true,
    "block_network_outbound_by_default": false
  },
  "policy_resolution_tiers": {
    "tier_1_specific_deny": [
      { "tool": "run_command", "pattern": "rm -rf /", "reason": "Root filesystem wipe attempt" },
      { "tool": "run_command", "pattern": "DROP DATABASE", "reason": "Destructive database drop" },
      { "tool": "run_command", "pattern": "DROP TABLE", "reason": "Destructive table drop" },
      { "tool": "run_command", "pattern": "git push .*--force", "reason": "Destructive force push" },
      { "tool": "run_command", "pattern": "curl .*\\|.*sh", "reason": "Unsafe piped remote script execution" }
    ],
    "tier_2_specific_ask": [
      { "tool": "run_command", "pattern": "npm publish", "reason": "Publishing release package to registry" },
      { "tool": "run_command", "pattern": "cargo publish", "reason": "Publishing crates to registry" },
      { "tool": "run_command", "pattern": "twine upload", "reason": "Publishing wheel to PyPI" },
      { "tool": "run_command", "pattern": "docker push", "reason": "Publishing container image" }
    ],
    "tier_3_specific_allow": [
      { "tool": "view_file" },
      { "tool": "find_file" },
      { "tool": "search_directory" },
      { "tool": "list_directory" },
      { "tool": "generate_image" }
    ],
    "tier_4_prefix_wildcard_deny": [
      { "prefix": "dangerous_mcp/*" }
    ],
    "tier_5_prefix_wildcard_ask": [
      { "prefix": "external_deploy/*" }
    ],
    "tier_6_prefix_wildcard_allow": [
      { "prefix": "internal_eval/*" }
    ],
    "tier_7_global_wildcard_deny": [],
    "tier_8_global_wildcard_ask": [
      { "tool": "run_command", "when": "unrecognized_command" }
    ],
    "tier_9_global_wildcard_allow": [
      { "tool": "*" }
    ]
  },
  "command_allowlist": {
    "permitted_prefixes": [
      "npx tsc",
      "npx eslint",
      "npx vitest",
      "npx playwright",
      "npx semgrep",
      "npx prisma",
      "npm test",
      "npm run",
      "python -m pytest",
      "pytest",
      "mypy",
      "uv run",
      "cargo check",
      "cargo test",
      "cargo build",
      "go test",
      "go vet",
      "go build",
      "git status",
      "git diff",
      "git branch",
      "git checkout",
      "git add",
      "git commit",
      "git log",
      "node .agents/"
    ]
  }
}
