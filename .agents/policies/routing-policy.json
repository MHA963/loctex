{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "AOS Universal Specialist Routing Policy",
  "version": "2.0.0",
  "routes": [
    {
      "pattern": "(discovery|intent|probe|requirement|scope|rfc|prd|interview)",
      "primary_agent": "POAI",
      "behavior_mode": "interactive",
      "model": "inherit",
      "workspace": "inherit"
    },
    {
      "pattern": "(schema|interface|type|zod|pydantic|protobuf|openapi|grpc|cli_arg_schema|contract|invariant)",
      "primary_agent": "AAI",
      "behavior_mode": "autonomous",
      "model": "inherit",
      "workspace": "branch"
    },
    {
      "pattern": "(mockup|design|visual|wireframe|color_palette|typography|axe|contrast|hci|terminal_layout)",
      "primary_agent": "UXAI",
      "behavior_mode": "interactive",
      "model": "inherit",
      "workspace": "branch"
    },
    {
      "pattern": "(ui|component|react|vue|svelte|tui|rich_terminal|ink|tailwind|css|animation|layout|view)",
      "primary_agent": "Fai",
      "prerequisite_event": "MOCKUP_APPROVED",
      "behavior_mode": "autonomous",
      "model": "inherit",
      "workspace": "branch"
    },
    {
      "pattern": "(systems|concurrency|cli_core|rust|go|python_core|database|prisma|migration|rls|postgres|sql|cache|redis|api|grpc_service)",
      "primary_agent": "BAI",
      "behavior_mode": "autonomous",
      "model": "inherit",
      "workspace": "branch"
    },
    {
      "pattern": "(security|sandbox|ast_scan|semgrep|bandit|token|vault|auth|boundary|csrf|secret_rotation)",
      "primary_agent": "SAI",
      "behavior_mode": "autonomous",
      "model": "inherit",
      "workspace": "branch"
    },
    {
      "pattern": "(ai|ml|cv|pytorch|tensorflow|rag|streaming|prompt|instructor|tensor_pipeline|llm_fallback)",
      "primary_agent": "EVAI",
      "mode": "ai_capability",
      "behavior_mode": "autonomous",
      "model": "inherit",
      "workspace": "branch"
    },
    {
      "pattern": "(evaluation|benchmark|eval_preset|self-improve|evolution|regression|telemetry_audit)",
      "primary_agent": "EVAI",
      "mode": "system_evolution",
      "behavior_mode": "autonomous",
      "model": "inherit",
      "workspace": "inherit"
    },
    {
      "pattern": "(test|unit_test|integration_test|cli_test|property_test|fuzz|pytest|cargo_test|playwright|vitest|qa|flaky)",
      "primary_agent": "QAI",
      "behavior_mode": "autonomous",
      "model": "inherit",
      "workspace": "inherit"
    },
    {
      "pattern": "(git|merge|release|commitlint|pr|changelog|package|pypi|crates|npm_publish|ci_cd)",
      "primary_agent": "GAI",
      "behavior_mode": "autonomous",
      "model": "inherit",
      "workspace": "inherit"
    }
  ]
}
