{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvolutionCandidateSchema",
  "description": "Schema for self-evolution proposals and candidate mutations in AOS.",
  "type": "object",
  "required": [
    "proposalId",
    "candidateId",
    "timestamp",
    "trigger",
    "diagnosis",
    "targetScope",
    "targetFile",
    "proposedMutation",
    "rationale",
    "governanceStatus"
  ],
  "properties": {
    "proposalId": {
      "type": "string",
      "description": "Unique proposal ID (e.g. 'prop-2026-09-001')."
    },
    "candidateId": {
      "type": "string",
      "description": "Unique candidate branch/id (e.g. 'cand-skill-fast-ast')."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "trigger": {
      "type": "string",
      "enum": ["telemetry_failure_pattern", "human_correction", "benchmark_regression", "token_waste_detection"]
    },
    "diagnosis": {
      "type": "string",
      "description": "Root cause analysis of the discovered deficiency."
    },
    "targetScope": {
      "type": "string",
      "enum": ["skills", "rules", "custom-agents", "policies"]
    },
    "targetFile": {
      "type": "string",
      "description": "Path to target file relative to .agents/"
    },
    "proposedMutation": {
      "type": "object",
      "required": ["diffType", "content"],
      "properties": {
        "diffType": { "type": "string", "enum": ["add_file", "patch_content", "replace_file", "delete_file"] },
        "content": { "type": "string" }
      }
    },
    "rationale": {
      "type": "string"
    },
    "governanceStatus": {
      "type": "string",
      "enum": ["proposed", "benchmarked", "verified_by_qai", "promoted", "rejected", "rolled_back"]
    },
    "replayResults": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
