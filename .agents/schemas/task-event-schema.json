{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskEventEnvelope",
  "description": "Structured JSON telemetry and state machine transition envelope for all inter-agent communication in ASP (Aegis Swarm Protocol).",
  "type": "object",
  "required": ["taskId", "timestamp", "agent", "event", "state", "artifacts", "status", "dependencies"],
  "properties": {
    "taskId": {
      "type": "string",
      "description": "Unique deterministic or UUID task identifier (e.g., 'task-auth-001')."
    },
    "parentTaskId": {
      "type": "string",
      "description": "Optional parent task identifier for hierarchical SOP decomposition."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp."
    },
    "agent": {
      "type": "string",
      "enum": ["POAI", "AAI", "UXAI", "Fai", "BAI", "EVAI", "SAI", "QAI", "GAI"],
      "description": "The emitting specialist agent role."
    },
    "event": {
      "type": "string",
      "enum": [
        "GOAL_DISCOVERY_STARTED",
        "GOAL_PROBING_INTERVIEW_COMPLETED",
        "GOAL_LOCKED",
        "TASK_PLANNED",
        "MOCKUP_GENERATED",
        "HUMAN_APPROVAL_REQUESTED",
        "HUMAN_APPROVED",
        "HUMAN_REJECTED",
        "DEPENDENCY_RESOLVED",
        "DEPENDENCY_BLOCKED",
        "CONTRACT_LOCKED",
        "CONTRACT_VERSION_BUMPED",
        "IMPLEMENTATION_STARTED",
        "IMPLEMENTATION_COMPLETED",
        "VERIFICATION_STARTED",
        "VERIFICATION_PASSED",
        "VERIFICATION_FAILED",
        "RCA_CLASSIFIED",
        "REFACTOR_STARTED",
        "RETRY_TRIGGERED",
        "TEST_QUARANTINED",
        "SECURITY_SCAN_PASSED",
        "SECURITY_SCAN_FAILED",
        "CAPABILITY_VIOLATION_BLOCKED",
        "RELEASE_READY",
        "RELEASE_COMPLETED",
        "TASK_CANCELLED",
        "TASK_FAILED",
        "TASK_ROLLED_BACK"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "DISCOVERY",
        "GOAL_LOCKED",
        "PLANNED",
        "WAITING_FOR_HUMAN",
        "WAITING_FOR_DEPENDENCY",
        "APPROVED",
        "CONTRACT_LOCKED",
        "IMPLEMENTING",
        "VERIFICATION",
        "RCA_REQUIRED",
        "REFACTORING",
        "RETRYING",
        "QUARANTINED",
        "RELEASED",
        "FAILED",
        "CANCELLED",
        "ROLLED_BACK",
        "discovery",
        "goal_locked",
        "planned",
        "contract_locked",
        "implementing",
        "verification",
        "blocked",
        "approved",
        "released",
        "rolled_back"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of file paths created or modified in this step."
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "blocked", "in_progress"]
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Prerequisite task IDs required for downstream progress."
    },
    "payload": {
      "type": "object",
      "description": "Optional diagnostic telemetry, benchmark metrics, or error contexts."
    }
  },
  "additionalProperties": false
}
