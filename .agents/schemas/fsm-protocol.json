{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "AOS Operational State Machine Protocol (SDK-Aligned Edition)",
  "version": "5.0.0",
  "description": "Machine-executable transition matrix defining formal preconditions, postconditions, timeouts, retry policies, and compensation logic for all 17 operational state transitions.",
  "states": [
    "DISCOVERY",
    "GOAL_LOCKED",
    "PLANNED",
    "WAITING_FOR_HUMAN",
    "WAITING_FOR_DEPENDENCY",
    "APPROVED",
    "CONTRACT_LOCKED",
    "IMPLEMENTING",
    "VERIFICATION",
    "RCA_REQUIRED",
    "REFACTORING",
    "RETRYING",
    "QUARANTINED",
    "RELEASED",
    "FAILED",
    "CANCELLED",
    "ROLLED_BACK"
  ],
  "transitions": [
    {
      "from": "DISCOVERY",
      "to": "GOAL_LOCKED",
      "event": "GOAL_LOCKED",
      "owner": "POAI",
      "preconditions": [
        "user_request_evaluated_across_4_discovery_dimensions",
        "interactive_probing_completed_if_ambiguous",
        "goal_contract_and_dod_locked"
      ],
      "postconditions": [
        "goal_contract_recorded_in_telemetry",
        "domain_and_stack_invariants_frozen"
      ],
      "timeout_ms": 86400000,
      "compensation": "reopen_discovery_interview"
    },
    {
      "from": "GOAL_LOCKED",
      "to": "PLANNED",
      "event": "TASK_PLANNED",
      "owner": "POAI",
      "preconditions": [
        "goal_state_equals_goal_locked",
        "atomic_subtasks_and_specialists_assigned"
      ],
      "postconditions": [
        "task_decomposition_spec_published",
        "dependencies_mapped"
      ],
      "timeout_ms": 60000,
      "compensation": "revert_to_goal_locked"
    },
    {
      "from": "PLANNED",
      "to": "WAITING_FOR_HUMAN",
      "event": "HUMAN_APPROVAL_REQUESTED",
      "owner": "UXAI",
      "preconditions": [
        "task_decomposed_by_poai",
        "mockup_or_design_brief_generated"
      ],
      "postconditions": [
        "ask_question_modal_rendered",
        "human_input_pending_in_telemetry"
      ],
      "timeout_ms": 86400000,
      "compensation": "auto_cancel_task_after_timeout"
    },
    {
      "from": "WAITING_FOR_HUMAN",
      "to": "APPROVED",
      "event": "HUMAN_APPROVED",
      "owner": "POAI",
      "preconditions": [
        "explicit_human_selection_recorded"
      ],
      "postconditions": [
        "design_spec_locked_with_approval_timestamp"
      ],
      "timeout_ms": 5000,
      "compensation": "revert_to_waiting_for_human"
    },
    {
      "from": "PLANNED",
      "to": "WAITING_FOR_DEPENDENCY",
      "event": "DEPENDENCY_BLOCKED",
      "owner": "POAI",
      "preconditions": [
        "upstream_dependencies_unresolved"
      ],
      "postconditions": [
        "task_suspended_in_dependency_graph"
      ],
      "timeout_ms": 3600000,
      "compensation": "notify_poai_dependency_deadlock"
    },
    {
      "from": "WAITING_FOR_DEPENDENCY",
      "to": "APPROVED",
      "event": "DEPENDENCY_RESOLVED",
      "owner": "POAI",
      "preconditions": [
        "all_prerequisite_tasks_in_state_released_or_contract_locked"
      ],
      "postconditions": [
        "task_unblocked_for_contract_locking"
      ],
      "timeout_ms": 5000,
      "compensation": "revert_to_waiting_for_dependency"
    },
    {
      "from": "APPROVED",
      "to": "CONTRACT_LOCKED",
      "event": "CONTRACT_LOCKED",
      "owner": "AAI",
      "preconditions": [
        "zod_or_pydantic_or_protobuf_schemas_authored",
        "openapi_or_cli_arg_specs_validated",
        "database_ddl_and_rls_committed_if_applicable",
        "contract_semver_tagged"
      ],
      "postconditions": [
        "contract_files_committed_to_base_branch",
        "zero_any_types_in_contract_exports"
      ],
      "timeout_ms": 60000,
      "compensation": "unlock_contract_and_reopen_architecture_phase"
    },
    {
      "from": "CONTRACT_LOCKED",
      "to": "IMPLEMENTING",
      "event": "IMPLEMENTATION_STARTED",
      "owner": "POAI",
      "preconditions": [
        "contract_state_equals_contract_locked",
        "isolated_git_worktree_created"
      ],
      "postconditions": [
        "specialist_agent_active_in_workspace_branch",
        "pre_edit_boundary_hooks_armed"
      ],
      "timeout_ms": 300000,
      "retryPolicy": {
        "max_attempts": 3,
        "backoff_strategy": "exponential",
        "initial_delay_ms": 2000,
        "max_delay_ms": 10000
      },
      "compensation": "clean_isolated_worktree_and_requeue"
    },
    {
      "from": "IMPLEMENTING",
      "to": "VERIFICATION",
      "event": "IMPLEMENTATION_COMPLETED",
      "owner": "QAI",
      "preconditions": [
        "subagent_produced_expected_artifacts",
        "pre_edit_checks_passed"
      ],
      "postconditions": [
        "post_task_hooks_triggered",
        "test_results_collected_in_telemetry"
      ],
      "timeout_ms": 180000,
      "compensation": "revert_uncommitted_changes_in_branch"
    },
    {
      "from": "VERIFICATION",
      "to": "RCA_REQUIRED",
      "event": "VERIFICATION_FAILED",
      "owner": "EVAI",
      "preconditions": [
        "quality_gate_exit_code_nonzero_or_test_assertion_failed"
      ],
      "postconditions": [
        "failure_classified_into_product_bug_test_bug_env_or_flake",
        "prohibited_from_blind_test_auto_editing"
      ],
      "timeout_ms": 30000,
      "compensation": "escalate_to_poai_for_manual_inspection"
    },
    {
      "from": "RCA_REQUIRED",
      "to": "REFACTORING",
      "event": "RCA_CLASSIFIED",
      "owner": "Specialist",
      "preconditions": [
        "rca_classification_report_produced",
        "target_scope_identified"
      ],
      "postconditions": [
        "targeted_implementation_refactoring_in_progress",
        "test_remains_locked_unless_test_bug_proven"
      ],
      "timeout_ms": 120000,
      "compensation": "abort_refactoring_and_mark_failed"
    },
    {
      "from": "RCA_REQUIRED",
      "to": "QUARANTINED",
      "event": "TEST_QUARANTINED",
      "owner": "QAI",
      "preconditions": [
        "rca_classified_as_flaky_with_timing_distribution_evidence"
      ],
      "postconditions": [
        "flaky_test_moved_to_tests_quarantine_folder",
        "quarantine_evidence_logged_to_telemetry",
        "dual_sign_off_required_to_heal"
      ],
      "timeout_ms": 15000,
      "compensation": "retain_test_in_active_suite_and_block_release"
    },
    {
      "from": "REFACTORING",
      "to": "VERIFICATION",
      "event": "VERIFICATION_STARTED",
      "owner": "QAI",
      "preconditions": [
        "refactored_code_committed_to_worktree"
      ],
      "postconditions": [
        "re_execution_of_quality_gates"
      ],
      "timeout_ms": 180000,
      "retryPolicy": {
        "max_attempts": 3,
        "backoff_strategy": "linear",
        "initial_delay_ms": 1000,
        "max_delay_ms": 5000
      },
      "compensation": "transition_to_failed_if_retry_budget_exhausted"
    },
    {
      "from": "VERIFICATION",
      "to": "RELEASED",
      "event": "RELEASE_COMPLETED",
      "owner": "GAI",
      "preconditions": [
        "post_task_and_pre_merge_quality_gates_exit_code_zero",
        "pre_production_zero_downtime_checks_passed",
        "zero_quarantined_tests_blocking_critical_path"
      ],
      "postconditions": [
        "linear_rebase_git_merge_to_main",
        "commitlint_conventional_commit_validated",
        "semver_tag_applied_and_changelog_updated"
      ],
      "timeout_ms": 60000,
      "compensation": "abort_merge_and_reopen_branch"
    },
    {
      "from": "RELEASED",
      "to": "ROLLED_BACK",
      "event": "TASK_ROLLED_BACK",
      "owner": "GAI",
      "preconditions": [
        "canary_monitoring_regression_detected_or_smoke_test_failure"
      ],
      "postconditions": [
        "backup_files_and_git_head_reverted_to_previous_semver",
        "post_mortem_incident_logged_to_anti_patterns"
      ],
      "timeout_ms": 30000,
      "compensation": "manual_human_escalation_alert"
    }
  ]
}
