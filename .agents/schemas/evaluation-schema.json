{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvaluationBenchmarkSchema",
  "description": "Schema for individual benchmark test specifications in AOS.",
  "type": "object",
  "required": ["id", "domain", "task", "expected_artifacts", "required_tests", "failure_conditions", "metrics"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique benchmark identifier (e.g. 'bench-fe-001')."
    },
    "domain": {
      "type": "string",
      "enum": ["frontend", "backend", "architecture", "security", "regression"]
    },
    "task": {
      "type": "string",
      "description": "The exact coding or architectural task given to the swarm."
    },
    "expected_artifacts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "File paths expected to be produced or updated."
    },
    "required_tests": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of deterministic test identifiers that must exit code 0."
    },
    "failure_conditions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Specific failure patterns that trigger instant test disqualification."
    },
    "metrics": {
      "type": "object",
      "required": ["min_test_pass_rate", "max_retry_count", "max_token_budget", "max_execution_time_ms"],
      "properties": {
        "min_test_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_retry_count": { "type": "integer", "minimum": 0 },
        "max_token_budget": { "type": "integer", "minimum": 1 },
        "max_execution_time_ms": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "additionalProperties": false
}
