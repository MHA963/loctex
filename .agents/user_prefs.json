{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "ASP (Aegis Swarm Protocol) Workspace Preferences",
  "version": "2.0.0",
  "workspace": {
    "active_project": "ASP - Aegis Swarm Protocol OS",
    "theme_mode": "auto",
    "hitl_approval_required": {
      "pr_merge": true,
      "database_migration": true,
      "remote_branch_deletion": true,
      "deployment_release": true
    }
  },
  "shift_schedule": {
    "daily_cap_hours": 2,
    "active_days": ["Monday", "Tuesday", "Wednesday", "Thursday"],
    "daily_github_activities_quota": 10,
    "weekend_blackout": {
      "enabled": true,
      "start": "Friday 00:00 UTC",
      "end": "Sunday 23:59 UTC"
    }
  },
  "quality_gates": {
    "static_typecheck": "tsc --noEmit",
    "visual_regression_check": "node .agents/skills/headless-visual-audit/scripts/audit.js",
    "zero_warnings_required": true
  }
}
