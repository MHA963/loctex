{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "VELOX Semantic Design Tokens",
  "version": "2.0.0",
  "themes": {
    "obsidian": {
      "--velox-surface-primary": "#050b14",
      "--velox-surface-secondary": "#0d1527",
      "--velox-surface-card": "rgba(13, 21, 39, 0.75)",
      "--velox-border-subtle": "rgba(255, 255, 255, 0.08)",
      "--velox-border-focus": "#00f0ff",
      "--velox-text-primary": "#f8fafc",
      "--velox-text-secondary": "#94a3b8",
      "--velox-text-muted": "#64748b"
    },
    "alabaster": {
      "--velox-surface-primary": "#ffffff",
      "--velox-surface-secondary": "#f8fafc",
      "--velox-surface-card": "rgba(255, 255, 255, 0.90)",
      "--velox-border-subtle": "rgba(0, 0, 0, 0.08)",
      "--velox-border-focus": "#0284c7",
      "--velox-text-primary": "#0f172a",
      "--velox-text-secondary": "#475569",
      "--velox-text-muted": "#64748b"
    }
  },
  "accents": {
    "--velox-accent-cyan": "#00f0ff",
    "--velox-accent-emerald": "#10b981",
    "--velox-accent-amber": "#f59e0b",
    "--velox-accent-crimson": "#ef4444"
  },
  "radii": {
    "--velox-radius-sm": "4px",
    "--velox-radius-md": "8px",
    "--velox-radius-lg": "12px",
    "--velox-radius-full": "9999px"
  }
}
